generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

////////////////////////////////////////////////////
// ENUMS
////////////////////////////////////////////////////

enum UserRole {
  CUSTOMER
  OWNER
  MANAGER
  DRIVER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum CustomerType {
  HOUSEHOLD
  BUSINESS
  RESTAURANT
  HOTEL
  INDUSTRIAL
}

////////////////////////////////////////////////////
// USER AUTHENTICATION
////////////////////////////////////////////////////

model User {
  id String @id @default(uuid())

  firstName String

  lastName String

  email String @unique

  phone String @unique

  password String

  role UserRole @default(CUSTOMER)

  status AccountStatus @default(ACTIVE)

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  customer Customer?

  driver Driver?

  roleId String?

  roleAssignment Role? @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]

  payments Payment[]

  sentMessages Message[] @relation("MessageSender")

  stockMovements StockMovement[]

  supplierApprovalsSubmitted SupplierApproval[] @relation("SupplierApprovalSubmitted")

  supplierApprovalsReviewed SupplierApproval[] @relation("SupplierApprovalReviewed")

  adminActions AdminActionLog[]

  conversationParticipants ConversationParticipant[]

  notifications Notification[]

  notificationPreference NotificationPreference?

  createdAt DateTime @default(now())

  updatedAt         DateTime           @updatedAt
  smsLogs           SmsLog[]
  emailLogs         EmailLog[]
  pushNotifications PushNotification[]
  otpCodes          OtpCode[]
  auditLogs         AuditLog[]
  activityLogs      ActivityLog[]

  @@index([email])
  @@index([phone])
  @@index([organizationId])
  @@index([role])
  @@index([status])
}

model RefreshToken {
  id String @id @default(uuid())

  token String @unique

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

////////////////////////////////////////////////////
// ORGANIZATION / LPG SUPPLIERS
////////////////////////////////////////////////////

model Organization {
  id String @id @default(uuid())

  name String

  registrationNumber String?

  email String?

  phone String?

  analytics SupplierAnalytics?

  status AccountStatus @default(ACTIVE)

  announcements Announcement[]

  conversations Conversation[]

  geoLocations ModelGeo[]

  supplierProfile SupplierProfile?

  supplierApprovals SupplierApproval[]

  users User[]

  reviews Review[]

  reputation SupplierReputation?

  complaints Complaint[]

  trustEvents TrustEvent[]

  responseMetrics SupplierResponseMetric[]

  orders Order[]

  aiPredictions AIPrediction[]

  aiInsights AIInsight[]

  supplierPerformance SupplierPerformanceScore?

  demandForecasts DemandForecast[]

  decisionLogs DecisionLog[]

  cylinders Cylinder[]

  promotions Promotion[]

  advertisements Advertisement[]

  cylinderMovements CylinderMovement[]

  branches Branch[]

  financialLedger FinancialLedger[]

  settlements SupplierSettlement[]

  supplierVerification SupplierVerification?

  supplierDocuments SupplierDocument[]

  supplierProducts SupplierProduct[]

  analyticsSnapshots AnalyticsSnapshot[]

  deliveryAnalytics DeliveryAnalytics[]

  revenueRecords RevenueRecord[]

  products Inventory[]

  warehouses Warehouse[]

  supplierPrices SupplierPrice[]

  platformRevenue PlatformRevenue[]

  drivers Driver[]

  vehicles Vehicle[]

  deliveries Delivery[]

  customers Customer[]

  createdAt DateTime @default(now())

  updatedAt            DateTime              @updatedAt
  purchaseLedgers      PurchaseLedger[]
  supplierPerformances SupplierPerformance[]
  organizationSettings OrganizationSetting[]
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  integrations         Integration[]

  @@index([name])
  @@index([status])
  @@index([registrationNumber])
}

model Branch {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  name String

  address String

  phone String?

  inventories Inventory[]

  geoLocations ModelGeo[]

  createdAt  DateTime    @default(now())
  warehouses Warehouse[]

  @@index([organizationId])
  @@index([name])
}

////////////////////////////////////////////////////
// SUPPLIER VERIFICATION
////////////////////////////////////////////////////

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model SupplierVerification {
  id String @id @default(uuid())

  organizationId String @unique

  organization Organization @relation(fields: [organizationId], references: [id])

  status VerificationStatus @default(PENDING)

  notes String?

  createdAt DateTime @default(now())
}

model SupplierDocument {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  documentType String

  documentUrl String

  createdAt DateTime @default(now())
}

////////////////////////////////////////////////////
// CUSTOMERS
////////////////////////////////////////////////////

model Customer {
  id String @id @default(uuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  type CustomerType @default(HOUSEHOLD)

  addresses CustomerAddress[]

  orders Order[]

  conversations Conversation[]

  geoLocations ModelGeo[]

  payments PaymentTransaction[]

  wallet CustomerWallet?

  cart Cart?

  complaints Complaint[]

  usageLogs UsageLog[]

  favouriteSuppliers FavouriteSupplier[]

  reviews Review[]

  refillReminders RefillReminder[]

  aiPredictions AIPrediction[]

  behaviourScore CustomerBehaviourScore?

  segments CustomerSegmentAssignment[]

  predictions ConsumptionPrediction[]

  loyaltyTransactions LoyaltyTransaction[]

  marketplaceSearches MarketplaceSearch[]

  recommendations SupplierRecommendation[]

  score CustomerScore?

  loyaltyAccount LoyaltyAccount?

  couponUsages CouponUsage[]

  locations CustomerLocation[]

  searchHistory SearchHistory[]

  preferences CustomerPreference?

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  organizationId String?

  cylinders Cylinder[]

  cylinderMovements CylinderMovement[]
  supplierReviews   SupplierReview[]
  checkoutSessions  CheckoutSession[]

  @@index([userId])
  @@index([type])
}

model CustomerAddress {
  id String @id @default(uuid())

  customerId String

  customer Customer @relation(fields: [customerId], references: [id])

  label String

  address String

  province String

  district String

  latitude Float?

  longitude Float?

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([province])
  @@index([district])
}

////////////////////////////////////////////////////
// DRIVER MANAGEMENT
////////////////////////////////////////////////////

model Driver {
  id String @id @default(uuid())

  userId String @unique

  organizationId String

  user User @relation(fields: [userId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id])

  licenseNumber String?

  active Boolean @default(true)

  deliveries Delivery[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

////////////////////////////////////////////////////
// LPG PRODUCT CATALOGUE
////////////////////////////////////////////////////

enum ProductCategory {
  LPG
  CYLINDER
  ACCESSORY
}

model Product {
  id String @id @default(uuid())

  name String

  description String?

  lpgProfile LPGProduct?

  category ProductCategory

  unit String

  supplierProducts SupplierProduct[]

  supplierPrices SupplierPrice[]

  inventories Inventory[]

  promotionProducts PromotionProduct[]

  demandForecasts DemandForecast[]

  supplierLocations SupplierServiceArea[]

  marketplaceProducts SupplierMarketplaceProduct[]

  reviews Review[]

  purchaseItems PurchaseItem[]

  orderItems OrderItem[]

  usageLogs UsageLog[]

  demandAnalytics ProductDemandAnalytics[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]
  cylinders      Cylinder[]
  cartItems      CartItem[]

  @@index([category])
  @@index([name])
}

////////////////////////////////////////////////////
// SUPPLIER PRODUCT OFFERINGS
////////////////////////////////////////////////////

model SupplierProduct {
  id String @id @default(uuid())

  organizationId String

  productId String

  organization Organization @relation(fields: [organizationId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  sellingPrice Float

  active Boolean @default(true)

  createdAt DateTime   @default(now())
  cartItems CartItem[]

  @@unique([organizationId, productId])
  @@index([organizationId])
  @@index([productId])
  @@index([active])
}

////////////////////////////////////////////////////
// INVENTORY MANAGEMENT
////////////////////////////////////////////////////

model Inventory {
  id String @id @default(uuid())

  warehouseId String

  productId String

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  quantity Float @default(0)

  reservedQuantity Float @default(0)

  availableQuantity Float @default(0)

  minimumStock Float @default(0)

  stockMovements StockMovement[]

  updatedAt DateTime @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  branchId       String?

  @@unique([warehouseId, productId])
  @@index([branchId])
  @@index([productId])
}

////////////////////////////////////////////////////
// ORDER ENUMS
////////////////////////////////////////////////////

enum PaymentMethod {
  CASH

  MOBILE_MONEY

  BANK

  CARD
}

////////////////////////////////////////////////////
// ORDER MANAGEMENT
////////////////////////////////////////////////////

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  organizationId String

  customerId String

  organization Organization @relation(fields: [organizationId], references: [id])

  customer Customer @relation(fields: [customerId], references: [id])

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  paymentMethod PaymentMethod?

  subtotal Float

  deliveryFee Float @default(0)

  totalAmount Float

  notes String?

  orderItems OrderItem[]

  couponUsages CouponUsage[]

  reviews Review[]

  complaints Complaint[]

  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])

  payments PaymentTransaction[]

  delivery Delivery?

  createdAt DateTime @default(now())

  updatedAt         DateTime         @updatedAt
  payment           Payment?
  usageLogs         UsageLog[]
  supplierReviews   SupplierReview[]
  checkoutSessionId String?

  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String

  productId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  quantity Float

  unitPrice Float

  totalPrice Float

  @@index([orderId])
  @@index([productId])
}

////////////////////////////////////////////////////
// DELIVERY STATUS
////////////////////////////////////////////////////

enum DeliveryStatus {
  PENDING

  ASSIGNED

  PICKED_UP

  IN_TRANSIT

  ARRIVED

  DELIVERED

  FAILED

  CANCELLED
}

model Vehicle {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  registrationNumber String @unique

  model String?

  capacity Float?

  active Boolean @default(true)

  deliveries Delivery[]

  createdAt DateTime @default(now())
}

////////////////////////////////////////////////////
// DELIVERY MANAGEMENT
////////////////////////////////////////////////////

model Delivery {
  id String @id @default(uuid())

  orderId String @unique

  order Order @relation(fields: [orderId], references: [id])

  driverId String?

  driver Driver? @relation(fields: [driverId], references: [id])

  vehicleId String?

  riskScore DeliveryRiskScore?

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  status DeliveryStatus @default(PENDING)

  deliveryAddress String

  latitude Float?

  longitude Float?

  scheduledAt DateTime?

  pickedUpAt DateTime?

  deliveredAt DateTime?

  proofOfDeliveryUrl String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  organization   Organization?   @relation(fields: [organizationId], references: [id])
  organizationId String?
  deliveryEvents DeliveryEvent[]

  geoLocations ModelGeo[]

  @@index([orderId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledAt])
}

////////////////////////////////////////////////////
// CUSTOMER LPG USAGE TRACKING
////////////////////////////////////////////////////

model UsageLog {
  id String @id @default(uuid())

  customerId String

  customer Customer @relation(fields: [customerId], references: [id])

  orderId String?

  order Order? @relation(fields: [orderId], references: [id])

  productId String

  product Product @relation(fields: [productId], references: [id])

  quantity Float

  usageDate DateTime @default(now())

  source String?

  @@index([customerId])
  @@index([productId])
  @@index([usageDate])
}

////////////////////////////////////////////////////
// CONSUMPTION PREDICTION ENGINE
////////////////////////////////////////////////////

model ConsumptionPrediction {
  id String @id @default(uuid())

  customerId String

  customer Customer @relation(fields: [customerId], references: [id])

  averageConsumption Float

  averageDaysBetweenOrders Float

  predictedNextOrder DateTime

  confidenceScore Float

  generatedAt DateTime @default(now())

  refillReminders RefillReminder[]

  @@index([customerId])
}

////////////////////////////////////////////////////
// SUPPLIER ANALYTICS
////////////////////////////////////////////////////

model SupplierAnalytics {
  id String @id @default(uuid())

  organizationId String @unique

  organization Organization @relation(fields: [organizationId], references: [id])

  totalOrders Int @default(0)

  completedOrders Int @default(0)

  cancelledOrders Int @default(0)

  averageDeliveryTime Float?

  averageRating Float?

  customerRetention Float?

  updatedAt DateTime @updatedAt
}

////////////////////////////////////////////////////
// CUSTOMER VALUE SCORING
////////////////////////////////////////////////////

model CustomerScore {
  id String @id @default(uuid())

  customerId String @unique

  customer Customer @relation(fields: [customerId], references: [id])

  lifetimeValue Float @default(0)

  totalOrders Int @default(0)

  totalSpent Float @default(0)

  purchaseFrequency Float @default(0)

  loyaltyScore Float @default(0)

  reliabilityScore Float @default(0)

  updatedAt DateTime @updatedAt
}

////////////////////////////////////////////////////
// PURCHASE LEDGER
////////////////////////////////////////////////////

model PurchaseLedger {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  supplierName String

  invoiceNumber String?

  totalAmount Float

  purchasedAt DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id String @id @default(uuid())

  purchaseId String

  productId String

  purchase PurchaseLedger @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  quantity Float

  costPrice Float
}

////////////////////////////////////////////////////
// ORDER ENUMS
////////////////////////////////////////////////////

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

////////////////////////////////////////////////////
// CART MANAGEMENT
////////////////////////////////////////////////////

model Cart {
  id String @id @default(uuid())

  customerId String @unique

  customer Customer @relation(fields: [customerId], references: [id])

  items CartItem[]

  createdAt DateTime @default(now())

  updatedAt        DateTime          @updatedAt
  checkoutSessions CheckoutSession[]
}

model CartItem {
  id String @id @default(uuid())

  cartId String

  productId String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  quantity Float

  createdAt DateTime @default(now())

  supplierProduct   SupplierProduct? @relation(fields: [supplierProductId], references: [id])
  supplierProductId String?
}

////////////////////////////////////////////////////
// PLATFORM REVENUE
////////////////////////////////////////////////////

enum RevenueType {
  COMMISSION

  SUBSCRIPTION

  ADVERTISEMENT
}

model PlatformRevenue {
  id String @id @default(uuid())

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  type RevenueType

  amount Float

  reference String?

  createdAt DateTime @default(now())
}

////////////////////////////////////////////////////
// ROLE BASED ACCESS CONTROL
////////////////////////////////////////////////////

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  EXPORT
}

model Role {
  id String @id @default(uuid())

  name String @unique

  description String?

  users User[]

  permissions RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Permission {
  id String @id @default(uuid())

  name String @unique

  module String

  action PermissionAction

  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

////////////////////////////////////////////////////
// ROLE PERMISSION MANAGEMENT
////////////////////////////////////////////////////

model RolePermission {
  id String @id @default(uuid())

  roleId String

  permissionId String

  role Role @relation(fields: [roleId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

////////////////////////////////////////////////////
// NOTIFICATIONS & COMMUNICATION
////////////////////////////////////////////////////

enum NotificationType {
  ORDER

  DELIVERY

  PAYMENT

  PROMOTION

  SYSTEM

  MESSAGE

  INVENTORY
}

enum NotificationChannel {
  IN_APP

  EMAIL

  SMS

  PUSH
}

enum NotificationStatus {
  UNREAD

  READ

  ARCHIVED

  PENDING
}

model Notification {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id])

  type NotificationType

  channel NotificationChannel @default(IN_APP)

  title String

  message String

  status NotificationStatus @default(UNREAD)

  referenceId String?

  createdAt DateTime @default(now())

  readAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

////////////////////////////////////////////////////
// INTERNAL MESSAGING
////////////////////////////////////////////////////

enum MessageStatus {
  SENT

  DELIVERED

  READ
}

model Conversation {
  id String @id @default(uuid())

  customerId String

  customer Customer @relation(fields: [customerId], references: [id])

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())

  conversationParticipants ConversationParticipant[]
}

model ConversationParticipant {
  id String @id @default(uuid())

  conversationId String

  userId String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id String @id @default(uuid())

  conversationId String

  conversation Conversation @relation(fields: [conversationId], references: [id])

  senderId String

  sender User @relation("MessageSender", fields: [senderId], references: [id])

  content String

  status MessageStatus @default(SENT)

  createdAt DateTime @default(now())
}

model NotificationPreference {
  id String @id @default(uuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  emailEnabled Boolean @default(true)

  smsEnabled Boolean @default(true)

  pushEnabled Boolean @default(true)

  promotionsEnabled Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

////////////////////////////////////////////////////
// LPG PRODUCT MANAGEMENT
////////////////////////////////////////////////////

enum LPGProductType {
  GAS

  CYLINDER

  ACCESSORY
}

enum CylinderSize {
  KG_3

  KG_6

  KG_9

  KG_12_5

  KG_15

  KG_48
}

enum CylinderStatus {
  AVAILABLE

  ASSIGNED

  WITH_CUSTOMER

  IN_TRANSIT

  EMPTY

  DAMAGED

  RETIRED
}

model LPGProduct {
  id String @id @default(uuid())

  productId String @unique

  product Product @relation(fields: [productId], references: [id])

  type LPGProductType

  cylinderSize CylinderSize?

  gasCapacity Float?

  refillRequired Boolean @default(false)

  createdAt DateTime @default(now())
}

model Cylinder {
  id String @id @default(uuid())

  serialNumber String @unique

  productId String

  product Product @relation(fields: [productId], references: [id])

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  status CylinderStatus @default(AVAILABLE)

  currentCustomerId String?

  currentCustomer Customer? @relation(fields: [currentCustomerId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  cylinderMovements CylinderMovement[]
}

model CylinderMovement {
  id String @id @default(uuid())

  cylinderId String

  cylinder Cylinder @relation(fields: [cylinderId], references: [id])

  fromStatus CylinderStatus?

  toStatus CylinderStatus

  customerId String?

  customer Customer? @relation(fields: [customerId], references: [id])

  reference String?

  createdAt DateTime @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
}

////////////////////////////////////////////////////
// INVENTORY & WAREHOUSE MANAGEMENT
////////////////////////////////////////////////////

enum WarehouseType {
  MAIN

  DEPOT

  SHOP

  MOBILE
}

model Warehouse {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  branchId String?

  branch Branch? @relation(fields: [branchId], references: [id])

  name String

  type WarehouseType @default(MAIN)

  address String

  province String

  district String

  latitude Float?

  longitude Float?

  inventory Inventory[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum StockMovementType {
  PURCHASE

  SALE

  TRANSFER

  ADJUSTMENT

  DAMAGE

  RETURN
}

model StockMovement {
  id String @id @default(uuid())

  inventoryId String

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  type StockMovementType

  quantity Float

  previousQuantity Float

  newQuantity Float

  reference String?

  performedById String?

  performedBy User? @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  product   Product? @relation(fields: [productId], references: [id])
  productId String?
}

model SupplierPrice {
  id String @id @default(uuid())

  organizationId String

  productId String

  organization Organization @relation(fields: [organizationId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  price Float

  effectiveFrom DateTime @default(now())

  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([organizationId, productId])
}

////////////////////////////////////////////////////
// PAYMENTS
////////////////////////////////////////////////////

enum PaymentStatus {
  PENDING

  PROCESSING

  SUCCESS

  FAILED

  REFUNDED
}

model Payment {
  id String @id @default(uuid())

  userId String

  orderId String @unique

  order Order @relation(fields: [orderId], references: [id])

  user User @relation(fields: [userId], references: [id])

  amount Float

  method PaymentMethod

  status PaymentStatus @default(PENDING)

  transactionReference String?

  paidAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model DeliveryEvent {
  id String @id @default(uuid())

  deliveryId String

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  status DeliveryStatus

  latitude Float?

  longitude Float?

  note String?

  createdAt DateTime @default(now())
}

model LoyaltyTransaction {
  id String @id @default(uuid())

  customerId String

  customer Customer @relation(fields: [customerId], references: [id])

  type LoyaltyTransactionType

  points Int

  balanceAfter Int

  description String?

  createdAt DateTime @default(now())
}

enum ReminderStatus {
  PENDING

  SENT

  CANCELLED
}

model RefillReminder {
  id String @id @default(uuid())

  customerId String

  customer Customer @relation(fields: [customerId], references: [id])

  predictionId String?

  prediction ConsumptionPrediction? @relation(fields: [predictionId], references: [id])

  scheduledFor DateTime

  status ReminderStatus @default(PENDING)

  sentAt DateTime?

  createdAt DateTime @default(now())
}

model CustomerPreference {
  id String @id @default(uuid())

  customerId String @unique

  customer Customer @relation(fields: [customerId], references: [id])

  preferredDeliveryTime String?

  preferredPaymentMethod PaymentMethod?

  marketingOptIn Boolean @default(true)

  smsNotifications Boolean @default(true)

  emailNotifications Boolean @default(true)

  pushNotifications Boolean @default(true)

  updatedAt DateTime @updatedAt
}

////////////////////////////////////////////////////
// ANALYTICS ENGINE
////////////////////////////////////////////////////

enum AnalyticsPeriod {
  DAILY

  WEEKLY

  MONTHLY

  YEARLY
}

model AnalyticsSnapshot {
  id String @id @default(uuid())

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  period AnalyticsPeriod

  periodStart DateTime

  periodEnd DateTime

  totalOrders Int @default(0)

  completedOrders Int @default(0)

  cancelledOrders Int @default(0)

  totalRevenue Float @default(0)

  averageOrderValue Float @default(0)

  totalCustomers Int @default(0)

  newCustomers Int @default(0)

  returningCustomers Int @default(0)

  createdAt DateTime @default(now())
}

model SupplierPerformance {
